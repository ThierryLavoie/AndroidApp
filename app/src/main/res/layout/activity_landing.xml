<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_kid">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/landingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/landing_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="#D81B60"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/landingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/landing_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="#555555" />

        <!-- Avatar Section -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/avatar_bg"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/avatarBase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:text="😶"
                android:textSize="100sp" />

            <TextView
                android:id="@+id/avatarHat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/avatarGlasses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="25dp"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/avatarChest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/avatarCompanion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:textSize="48sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShop"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_shop"
                android:textColor="@color/vibrant_pink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomize"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_customize"
                android:textColor="@color/playful_blue" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#E1F5FE">

                <TextView
                    android:id="@+id/totalPointsView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_points_format"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/playful_blue"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/userRankView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/user_rank_format"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="#78909C" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClockGame"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:text="@string/btn_clock_game"
            app:backgroundTint="@color/playful_blue"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMentalMath"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="@string/btn_mental_math"
            app:backgroundTint="@color/fresh_green"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReadingGame"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="@string/btn_reading_game"
            app:backgroundTint="@color/energetic_orange"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReadingGameEn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="@string/btn_reading_game_en"
            app:backgroundTint="@color/vibrant_pink"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpellingGame"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="@string/btn_spelling_game"
            app:backgroundTint="@color/soft_purple"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp" />

        <RadioGroup
            android:id="@+id/languageSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/languageEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english"
                android:buttonTint="@color/playful_blue" />

            <RadioButton
                android:id="@+id/languageFrench"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/language_french"
                android:buttonTint="@color/playful_blue" />
        </RadioGroup>

        <Button
            android:id="@+id/btnAbout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_about"
            android:textColor="#78909C"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
